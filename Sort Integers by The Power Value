class Solution {
    HashMap<Integer, Integer> memo = new HashMap<>();
    PriorityQueue<Pair<Integer, Integer>> maxHeap = new PriorityQueue<>(Solution::myComparator);
    
    public static int myComparator(Pair<Integer, Integer> a, Pair<Integer, Integer> b) {
        if (a.getKey() < b.getKey()) {
            return 1; 
        } else if (a.getKey() > b.getKey()) {
            return -1;
        } else {
            return Integer.compare(b.getValue(), a.getValue());
        }
    }

    public int getKth(int lo, int hi, int k) {
        for(int num = lo; num <= hi; num ++) {
            int steps = findPower(num);
            maxHeap.offer(new Pair(steps, num));
            if(maxHeap.size() > k) {
                maxHeap.poll();
            }
        }

        return maxHeap.poll().getValue();
    }

    public int findPower(int num) {
        int steps = 0;

        if(num == 1) {
            return steps;
        }

        if(memo.containsKey(num)) {
            return memo.get(num);
        }

        if(num % 2 == 0) {
            steps += findPower(num / 2) + 1;
        } else {
            steps += findPower(3 * num + 1) + 1;
        }

        memo.put(num, steps);
        return steps;
    }
}
